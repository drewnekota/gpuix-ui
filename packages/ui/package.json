{
  "name": "@gpuix-ui/react",
  "version": "0.1.0",
  "description": "shadcn-style styled components for GPUIX. Copy the source into your app or import from the package.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.tsx"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gpuix-ui/core": "workspace:*",
    "@gpuix-ui/primitives": "workspace:*"
  },
  "peerDependencies": {
    "@gpuix/react": "^0.7.0",
    "react": ">=19"
  },
  "devDependencies": {
    "@gpuix/react": "^0.7.0",
    "react": "^19.2.4"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/drewnekota/gpuix-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/drewnekota/gpuix-ui",
  "keywords": [
    "gpuix",
    "gpui",
    "react",
    "ui",
    "shadcn",
    "native"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  }
}
